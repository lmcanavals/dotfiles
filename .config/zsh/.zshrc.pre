# stuff for interactive shells, colors and the like

LCLR=$(<"$ZDOTDIR/colors")
export LCLR

export EDITOR=nvim

# pacdiff stuff
export DIFFPROG='nvim -d'
#export DIFFSEARCHPATH='/etc' # override the search path (only when using find)
#export MERGEPROG='diff3 -m'  # override the 3-way merge program

# fzf
export FZF_DEFAULT_COMMAND='fd --type f'
export FZF_CTRL_T_COMMAND='fd --type d'

lismosh && export ISMOSHBRUH="yup"

# vim: set ts=2:sw=2:noet:sts=2:
