[core]
	editor = nvim
	autocrlf = input
	pager = delta

[user]
	name = Luis M Canaval S
	email = public02@canaval.org

[init]
	defaultBranch = main

[pull]
	rebase = false

[credential "https://github.com"]
	helper =
	helper = !gh auth git-credential

[diff]
    tool = nvimdiff

[difftool]
    prompt = true

[merge]
	tool = nvimdiff
	conflictstyle = zdiff3

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true

[include]
  path = ~/.config/git/theme.gitconfig
