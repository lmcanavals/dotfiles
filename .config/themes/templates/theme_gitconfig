# target: ~/.config/git/theme.gitconfig
# Don't edit this file, It's auto-generated by thm

[color "status"]
	added = "#{{git_added}}"
	changed = "#{{git_modified}}"
	untracked = "#{{muted}}"
	branch = "#{{td_violet}}"
	nobranch = "#{{git_deleted}}"
	localBranch = "#{{th_crimson}}"
	remoteBranch = "#{{t5_purple}}"
	unmerged = "#{{tg_redish}}"

[delta]
	plus-style = syntax "#{{accent_dim}}"
	plus-emph-style = syntax "#{{bg_highlight}}"
	minus-style = syntax "#{{error}}"
	minus-emph-style = syntax "#{{bg_highlight}}"

	line-numbers-minus-style = "#{{git_deleted}}"
	line-numbers-plus-style = "#{{git_added}}"
	line-numbers-zero-style = "#{{comment}}"
	line-numbers-left-format = "{nm:>4}│"
	line-numbers-right-format = "{np:>4}│"
