# target: ~/.config/fish/conf.d/zz_active_theme.fish
# Don't edit this file, It's auto-generated by thm

if status is-interactive
	if test "$TERM" = linux
		echo -en "\e]P1{{t0_bg}}"
		echo -en "\e]P1{{t1_red}}"
		echo -en "\e]P2{{t2_green}}"
		echo -en "\e]P3{{t3_orange}}"
		echo -en "\e]P4{{t4_blue}}"
		echo -en "\e]P5{{t5_purple}}"
		echo -en "\e]P6{{t6_cyan}}"
		echo -en "\e]P7{{t7_fgdark}}"
		echo -en "\e]P8{{t8_bglight}}"
		echo -en "\e]P9{{t9_pink}}"
		echo -en "\e]PA{{ta_green}}"
		echo -en "\e]PB{{tb_yellow}}"
		echo -en "\e]PC{{tc_blue}}"
		echo -en "\e]PD{{td_violet}}"
		echo -en "\e]PE{{te_aqua}}"
		echo -en "\e]PF{{tf_fg}}"
		clear # for background artifacting
	end

	set -gx LCTHEME "{{light_or_dark}}"
	set -gx BAT_THEME "{{bat_theme}}"
	set -gx FZF_DEFAULT_OPTS " \
		--highlight-line \
		--info=inline-right \
		--ansi \
		--layout=reverse \
		--border=none \
		--color=bg+:#{{bg_highlight}} \
		--color=bg:#{{bg}} \
		--color=border:#{{border}} \
		--color=fg:#{{fg}} \
		--color=gutter:#{{bg}} \
		--color=header:#{{accent_alt}} \
		--color=hl+:#{{accent}} \
		--color=hl:#{{accent}} \
		--color=info:#{{comment}} \
		--color=marker:#{{accent_dim}} \
		--color=pointer:#{{accent_dim}} \
		--color=prompt:#{{accent}} \
		--color=query:#{{fg}}:regular \
		--color=scrollbar:#{{accent}} \
		--color=separator:#{{accent_alt}} \
		--color=spinner:#{{accent_dim}}"

	fish_config theme choose "{{fish_theme}}" {% if fish_color_theme %}--color-theme={{fish_color_theme}}{% endif %}
end
