#!/usr/bin/env zsh

# Pure Zsh ancestry check using the /proc filesystem (No pstree, no grep)
has_ancestor_mosh() {
	local target_pid=$1
	local parent_pid=""
	local comm=""

	# Traverse up the process tree until PID 1 or 0
	while ((target_pid > 1)); do
		# Format of /proc/PID/stat: PID (executable_name) State PPID ...
		if [[ ! -f "/proc/$target_pid/stat" ]]; then
			break
		fi

		# Read the contents into a variable
		local stat_content=$(<"/proc/$target_pid/stat")

		# Extract executable name inside parentheses and PPID using Zsh regex
		if [[ "$stat_content" =~ '^([0-9]+)\ \(([^)]+)\)\ [A-Z]\ ([0-9]+)' ]]; then
			comm="${match[2]}"
			parent_pid="${match[3]}"

			# Check if this ancestor is the mosh-server
			if [[ "$comm" == "mosh-server" ]]; then
				return 0
			fi
			target_pid=$parent_pid
		else
			break
		fi
	done

	return 1
}

is_mosh() {
	local verbose=0

	# Fast argument parsing using standard Zsh structures
	local arg
	for arg in "$@"; do
		case "$arg" in
		-v | --verbose) verbose=1 ;;
		esac
	done

	local check_pid="$$"

	# Handle TMUX environment natively without calling tmux list-clients if possible
	if [[ -n "$TMUX" ]]; then
		# TMUX env variable contains: "path_to_socket,pid,session_index"
		# We can extract the TMUX server/client PID natively using Zsh modifiers
		check_pid="${${TMUX#*,}%*,}"
	fi

	# Run the ultra-fast /proc check
	if has_ancestor_mosh "$check_pid"; then
		((verbose)) && print -r "mosh"
		return 0
	fi

	return 1
}

# Determine if the script is being sourced or executed directly
local sourced=0
case "$ZSH_EVAL_CONTEXT" in
*:file | *:toplevel) sourced=1 ;;
esac

if ((!sourced)); then
	is_mosh "$@"
fi
