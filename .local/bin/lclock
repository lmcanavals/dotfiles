#!/usr/bin/env zsh

# Use standard XDG fallback if the variable is empty
local color_file="${XDG_CONFIG_HOME:-$HOME/.config}/lmcscolors"
local LCLR=""
[[ -f "$color_file" ]] && LCLR=$(<"$color_file")

# Fixed length substrings using Zsh offset syntax
COLOR_ADDED="${LCLR:16:7}"
COLOR_CLEAN="${LCLR:96:7}"
COLOR_DELETED="${LCLR:72:7}"
COLOR_DIVERGED="${LCLR:24:7}"
COLOR_MODIFIED="${LCLR:88:7}"
COLOR_STAGED="${LCLR:112:7}"
COLOR_UNTRACKED="${LCLR:56:7}"

ICON_AHEAD=$'\uf093'     # 
ICON_BEHIND=$'\uf019'    # 
ICON_BRANCH=$'\uf126'    # 
ICON_CHECK=$'\uf1d2'     # 
ICON_COMMITTED=$'\ue729' # 
ICON_DIVERGED=$'\ue728'  # 
ICON_MODIFIED=$'\uf14b'  # 
ICON_UNTRACKED=$'\uf059' # 

tag() {
	print -nr "<span foreground=\"$1\">$2</span>"
}

dotfiles_status() {
	local -a dotfiles=(--git-dir="$HOME/.dotfiles.git" --work-tree="$HOME")

	# Check if we are inside a git repository
	git "${dotfiles[@]}" rev-parse --is-inside-work-tree &>/dev/null || return 0

	# 1. Store porcelain status into a native Zsh array (line-by-line split)
	local -a status_lines
	status_lines=("${(@f)$(git "${dotfiles[@]}" status -u --porcelain=v1 --branch 2>/dev/null)}")

	local branch_info="${status_lines[1]}"
	local current_branch=""
	local -i ahead=0 behind=0 staged_count=0 modified_count=0 untracked_count=0
	local branch_color="$COLOR_CLEAN"

	# 2. Pure Zsh regex matching
	if [[ "$branch_info" =~ '^## ([^.]+)' ]]; then
		current_branch="${match[1]}"
		if [[ "$branch_info" =~ 'ahead ([0-9]+)' ]]; then ahead=${match[1]}; fi
		if [[ "$branch_info" =~ 'behind ([0-9]+)' ]]; then behind=${match[1]}; fi
	else
		current_branch=$(git "${dotfiles[@]}" rev-parse --short HEAD 2>/dev/null)
	fi

	# 3. Parse remaining lines natively
	local line
	for line in "${status_lines[@]:1}"; do
		[[ -z "$line" ]] && continue
		case "${line:0:2}" in
		\?\?*) ((untracked_count++)) ;;
		[MARCUD][\ ]*) ((staged_count++)) ;;
		?*)
			[[ "${line:0:1}" != " " ]] && ((staged_count++))
			[[ "${line:1:1}" =~ '[MD]' ]] && ((modified_count++))
			;;
		esac
	done

	if ((ahead > 0 || behind > 0 || staged_count > 0 || modified_count > 0 || untracked_count > 0)); then
		branch_color="$COLOR_MODIFIED"
	fi

	local output
	output="$(tag "$branch_color" "$ICON_BRANCH $current_branch")"

	if ((ahead > 0 && behind > 0)); then
		output+=" $(tag "$COLOR_DIVERGED" "$ICON_DIVERGED")"
	elif ((ahead > 0)); then
		output+=" $(tag "$COLOR_ADDED" "$ICON_AHEAD $ahead")"
	elif ((behind > 0)); then
		output+=" $(tag "$COLOR_DELETED" "$ICON_BEHIND $behind")"
	fi

	# this is a workaround to inject \r on the output. waybar only accepts \r not \n. hyprlock doesn't care
	local CR="\n"

	((staged_count > 0)) && output+="${CR}$(tag "$COLOR_STAGED" "$ICON_COMMITTED $staged_count staged") "
	((modified_count > 0)) && output+="${CR}$(tag "$COLOR_MODIFIED" "$ICON_MODIFIED $modified_count modified") "
	((untracked_count > 0)) && output+="${CR}$(tag "$COLOR_UNTRACKED" "$ICON_UNTRACKED $untracked_count untracked")"

	if ((staged_count == 0 && modified_count == 0 && untracked_count == 0 && ahead == 0 && behind == 0)); then
		output="$(tag "$COLOR_CLEAN" "<b>$ICON_CHECK  files synced</b>")${CR}${output}"
	else
		output="$(tag "$COLOR_MODIFIED" "<b>$ICON_CHECK  files out of sync</b>")${CR}${output}"
	fi

	print -nr -- "$output"
}

ICON_H0=$'\uf4c3' ICON_H1=$'\uf444'
ICON_M0=$'\uf4c3' ICON_M1=$'\uf444'

local -a HOUR=({${ICON_H0},${ICON_H1}}{${ICON_H0},${ICON_H1}}{${ICON_H0},${ICON_H1}}{${ICON_H0},${ICON_H1}}{${ICON_H0},${ICON_H1}})
local -a MINUTE=({${ICON_M0},${ICON_M1}}{${ICON_M0},${ICON_M1}}{${ICON_M0},${ICON_M1}}{${ICON_M0},${ICON_M1}}{${ICON_M0},${ICON_M1}}{${ICON_M0},${ICON_M1}})

cool_time() {
	local -a current_time=(${(f)"$(date +'%H%n%M')"})
	local -i hr=$((10#${current_time[1]}))
	local -i min=$((10#${current_time[2]}))

	print -nr -- "<b>${HOUR[hr + 1]}</b>:${MINUTE[min + 1]}"
}

bclock_dotstatus() {
	local tip="$(dotfiles_status)"
	#print -f '{"text": "%s", "tooltip": "%s"}\n' "$(cool_time)" "${tip//\"/\\\"}"
	print -f '{"text": "%s", "tooltip": "%s"}\n' "$(cool_time)" "${tip//\"/\\\"}"
}

# Entry point
local -a once=()
local -a bclock=()
local -a dotinfo=()
local -a raw=()

zparseopts -E {o,-once}=once {b,-bclock}=bclock {d,-dotinfo}=dotinfo {r,-raw}=raw

if ((${#once} > 0)); then
	bclock_dotstatus
elif ((${#bclock} > 0)); then
	print -f '%s\n' "$(cool_time)"
elif ((${#dotinfo} > 0)); then
	print -f '%s\n' "$(dotfiles_status)"
elif ((${#raw} > 0)); then
	print -f '%s\n%s\n' "$(cool_time)" "$(dotfiles_status)"
else
	while true; do
		bclock_dotstatus
		sleep 10
	done
fi
